# GEMINI_API_KEY: Required for Gemini AI API calls (AI Security Assistant & Remediation Autopilot).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TRUSTRAIL_SESSION_SECRET: HMAC signing secret for session JWTs and Trust Center receipts.
# Must be >= 32 characters in production.
TRUSTRAIL_SESSION_SECRET="CHANGE_ME_IN_PRODUCTION_32_CHARS_MIN"

# TRUSTRAIL_VAULT_KEY & Rotation: Master AES-256-GCM key material for connector & MFA secrets.
# During key rotation, set TRUSTRAIL_VAULT_KEY_VERSION=2 and put old key in TRUSTRAIL_VAULT_PREVIOUS_KEY.
TRUSTRAIL_VAULT_KEY="CHANGE_ME_VAULT_MASTER_KEY_32_CHARS"
TRUSTRAIL_VAULT_KEY_VERSION="1"
# TRUSTRAIL_VAULT_PREVIOUS_KEY=""

# Persistence & Recovery Storage:
# TRUSTRAIL_DB_PATH="/var/lib/trustrail/trustrail.db"
# TRUSTRAIL_BACKUP_DIR="/var/lib/trustrail/backups"
# DATABASE_URL="postgres://trustrail:password@localhost:5432/trustrail"

# Cryptographic SLSA Provenance Attestation Secret (optional HMAC-SHA256 verification):
# TRUSTRAIL_ATTESTATION_SECRET=""

# Optional External Connector Credentials (connectors remain Disconnected until configured):
# GITHUB_TOKEN=""
# GITHUB_WEBHOOK_SECRET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_ROLE_ARN=""
# AWS_EXTERNAL_ID=""
# AZURE_ACCESS_TOKEN=""
# GCP_ACCESS_TOKEN=""
# SLACK_WEBHOOK_URL=""
